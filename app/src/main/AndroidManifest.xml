<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to push to the GitHub API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package visibility queries for Android 11+ (API 30+) -->
    <queries>
        <package android:name="com.lego.education.spikenext" />
        <package android:name="com.lego.spike" />
        <package android:name="com.lego.common.spike" />
        <package android:name="com.lego.education.spike" />
        <package android:name="com.lego.spike3" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/octet-stream" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PushToGitHub">

        <!-- Time Machine is the launcher entry point. -->
        <activity
            android:name=".TimeMachineActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Kanban Sticky Notes Activity -->
        <activity
            android:name=".KanbanActivity"
            android:exported="false"
            android:label="@string/kanban_title" />

        <!-- Settings / configuration screen. Reachable from toolbar menu. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- Share-receiver for .llsp3 files from SPIKE and other file types.
             Supports single or multiple file selection. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/share_target_label"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Documentation upload screen for photos, PDFs, text notes. -->
        <activity
            android:name=".DocUploadActivity"
            android:exported="false"
            android:label="@string/doc_upload_title">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- FileProvider for serving cached .llsp3 files to SPIKE. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
