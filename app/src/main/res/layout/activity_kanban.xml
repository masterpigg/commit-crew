<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="@string/kanban_title"
        app:titleTextColor="@android:color/white"
        app:menu="@menu/time_machine_menu" />

    <!-- Primary Section Toggle: Team Code vs Task Board -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/mainNavToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:background="?attr/colorPrimary"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navTaskBoard"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="📋 Task Board"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:strokeColor="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navSnapNotes"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="📸 Snap Notes"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:strokeColor="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navTeamCode"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="🤖 Team Code"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:strokeColor="@android:color/white" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Shown when the team's GitHub token is about to expire or has expired -->
    <TextView
        android:id="@+id/tokenExpiryBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warning_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/warning_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Single-Row Compact Filter & Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">

        <!-- Horizontal scroll for the single row of filters -->
        <HorizontalScrollView
            android:id="@+id/filterScrollView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filterBarContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 1. Default Trigger Buttons Group -->
                <LinearLayout
                    android:id="@+id/filterTriggersLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnFilterCategory"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="All Categories ▾"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        app:chipBackgroundColor="@android:color/white"
                        app:chipStrokeColor="#BDBDBD"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="18dp"
                        app:chipMinTouchTargetSize="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnFilterWorker"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="All Workers ▾"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        app:chipBackgroundColor="@android:color/white"
                        app:chipStrokeColor="#BDBDBD"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="18dp"
                        app:chipMinTouchTargetSize="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnFilterCoreValue"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="All Core Values ▾"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        app:chipBackgroundColor="@android:color/white"
                        app:chipStrokeColor="#BDBDBD"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="18dp"
                        app:chipMinTouchTargetSize="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnClearFilters"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="✕ Clear"
                        android:textSize="11sp"
                        android:textColor="#D32F2F"
                        app:chipBackgroundColor="#FFEBEE"
                        app:chipStrokeColor="#EF9A9A"
                        app:chipStrokeWidth="1dp"
                        android:visibility="gone"
                        app:chipMinTouchTargetSize="0dp" />

                </LinearLayout>

                <!-- 2. Expanded Category Chips Container -->
                <LinearLayout
                    android:id="@+id/expandedCategoryLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnCloseCategory"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="Category ▴"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        app:chipBackgroundColor="@color/brand_primary"
                        app:chipStrokeColor="@color/brand_primary"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="18dp"
                        app:chipMinTouchTargetSize="0dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/categoryFilterChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="All"
                            android:checked="true"
                            android:textColor="#212121"
                            app:chipBackgroundColor="@android:color/white"
                            app:chipStrokeColor="#BDBDBD"
                            app:chipStrokeWidth="1.5dp"
                            app:chipMinTouchTargetSize="0dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatRobot"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="🤖 Robot Game"
                            android:textColor="#212121"
                            app:chipBackgroundColor="@android:color/white"
                            app:chipStrokeColor="#BDBDBD"
                            app:chipStrokeWidth="1.5dp"
                            app:chipMinTouchTargetSize="0dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatInnovation"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="💡 Innovation"
                            android:textColor="#212121"
                            app:chipBackgroundColor="@android:color/white"
                            app:chipStrokeColor="#BDBDBD"
                            app:chipStrokeWidth="1.5dp"
                            app:chipMinTouchTargetSize="0dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatGeneral"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="📋 General"
                            android:textColor="#212121"
                            app:chipBackgroundColor="@android:color/white"
                            app:chipStrokeColor="#BDBDBD"
                            app:chipStrokeWidth="1.5dp"
                            app:chipMinTouchTargetSize="0dp" />

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>

                <!-- 3. Expanded Worker Chips Container -->
                <LinearLayout
                    android:id="@+id/expandedWorkerLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnCloseWorker"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="Worker ▴"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        app:chipBackgroundColor="@color/brand_primary"
                        app:chipStrokeColor="@color/brand_primary"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="18dp"
                        app:chipMinTouchTargetSize="0dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/ownerFilterChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true"
                        app:selectionRequired="false" />

                </LinearLayout>

                <!-- 4. Expanded Core Value Chips Container -->
                <LinearLayout
                    android:id="@+id/expandedCoreValueLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnCloseCoreValue"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="Core Value ▴"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        app:chipBackgroundColor="@color/brand_primary"
                        app:chipStrokeColor="@color/brand_primary"
                        app:chipStrokeWidth="1.5dp"
                        app:chipCornerRadius="18dp"
                        app:chipMinTouchTargetSize="0dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/coreValueFilterChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true"
                        app:selectionRequired="false" />

                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Compact New Sticky Note Button (Always visible on the right) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNewStickyNote"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="+ Task"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/brand_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <!-- 3 Columns Layout (Equal width side-by-side) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <!-- Column 1: To-Do -->
        <LinearLayout
            android:id="@+id/columnTodo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFF9C4"
            android:padding="8dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/column_todo"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#F57F17"
                android:paddingBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTodo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <!-- Column 2: Doing -->
        <LinearLayout
            android:id="@+id/columnDoing"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFE082"
            android:padding="8dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/column_doing"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:paddingBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDoing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <!-- Column 3: Done -->
        <LinearLayout
            android:id="@+id/columnDone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#C8E6C9"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/column_done"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:paddingBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
