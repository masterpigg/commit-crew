<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFDE7">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="What needs to be done?"
        app:placeholderText="e.g. Build coral arm, Test gyro turn"
        app:hintTextColor="#212121"
        app:boxStrokeColor="#212121"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111111"
            android:textColorHint="#757575"
            android:textSize="16sp"
            android:textStyle="bold"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Live Formatted Preview Box for Kids -->
    <TextView
        android:id="@+id/textTaskBodyPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:textSize="14sp"
        android:textColor="#111111"
        android:lineSpacingExtra="3dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- Rich Text Formatting Buttons for Kids -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFormatHeading"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="📌 Heading"
            android:textSize="11sp"
            android:textColor="#212121"
            app:strokeColor="#616161"
            android:padding="0dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFormatBold"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="B Bold"
            android:textSize="11sp"
            android:textColor="#212121"
            app:strokeColor="#616161"
            android:textStyle="bold"
            android:padding="0dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFormatChecklist"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="☑ Checklist"
            android:textSize="11sp"
            android:textColor="#212121"
            app:strokeColor="#616161"
            android:padding="0dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFormatBullet"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="• Bullet"
            android:textSize="11sp"
            android:textColor="#212121"
            app:strokeColor="#616161"
            android:padding="0dp" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Notes / Details"
        app:hintTextColor="#212121"
        app:boxStrokeColor="#212121"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputTaskBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111111"
            android:textColorHint="#757575"
            android:textSize="15sp"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Category / Workspace"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:paddingBottom="6dp" />

    <RadioGroup
        android:id="@+id/categoryGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/radioCatRobot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤖 Robot"
            android:textColor="#111111"
            android:textStyle="bold"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioCatInnovation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💡 Innovation"
            android:textColor="#111111"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/radioCatGeneral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 General"
            android:textColor="#111111"
            android:textStyle="bold" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Column / Status"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:paddingBottom="6dp" />

    <RadioGroup
        android:id="@+id/columnGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/radioTodo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="To-Do 📌"
            android:textColor="#111111"
            android:textStyle="bold"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioDoing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Doing 🛠️"
            android:textColor="#111111"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/radioDone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Done ✅"
            android:textColor="#111111"
            android:textStyle="bold" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Who's working on this? (Owners)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:paddingBottom="6dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/ownerChipsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="false" />

</LinearLayout>
